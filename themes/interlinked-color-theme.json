      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "link_uri",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4DFFBD"
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#1AFFA3"
      }
    },
    {
