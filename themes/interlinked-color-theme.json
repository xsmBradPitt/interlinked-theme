      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "punctuation.bracket",
      "scope": [
        "meta.brace",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments"
      ],
      "settings": {
        "foreground": "#FFE5B4"
      }
    },
    {
      "name": "punctuation.delimiter",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
