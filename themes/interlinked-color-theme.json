      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#4DFFBD"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4DFFBD"
      }
    },
    {
      "name": "annotation",
      "scope": [
        "meta.decorator",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#00FFB7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFDAB9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFB74D",
        "fontStyle": "bold"
      }
