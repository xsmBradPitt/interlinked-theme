  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4A7A7A"
      }
    },
    {
      "name": "comment.doc",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "preproc",
      "scope": [
        "meta.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#4A7A7A"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1AFFA3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#4DFFBD"
      }
    },
    {
      "name": "enum",
      "scope": [
        "entity.name.type.enum",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#00FFB7"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#FFE5B4"
      }
    },
    {
      "name": "variable.special",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#00FFB7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "entity.name.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#4DFFBD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#FFE5B4"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#00FFB7"
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#00FFB7"
      }
    },
    {
      "name": "string",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#FFDAB9"
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "string.regex",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "string.special",
      "scope": [
        "string.other",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#00CC99"
      }
    },
    {
      "name": "string.special.symbol",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#00FFB7"
      }
    },
    {
